{{- /* News feed for website → LinkedIn automation: Hugo's default RSS plus a 1200px JPEG enclosure per post. */ -}}
{{- $pages := .Pages -}}
{{- $limit := .Site.Config.Services.RSS.Limit -}}
{{- if ge $limit 1 }}{{ $pages = $pages | first $limit }}{{ end -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>News on {{ .Site.Title }}</title>
    <link>{{ .Permalink }}</link>
    <description>Recent news from {{ .Site.Title }}</description>
    <generator>Hugo</generator>
    <language>{{ site.Language.LanguageCode }}</language>
    {{- with $pages }}<lastBuildDate>{{ (index . 0).Lastmod.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>{{ end }}
    {{- with .OutputFormats.Get "RSS" }}
    {{ printf "<atom:link href=%q rel=\"self\" type=%q />" .Permalink .MediaType | safeHTML }}
    {{- end }}
    {{- range $pages }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .PublishDate.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      <guid>{{ .Permalink }}</guid>
      <description>{{ .Params.summary | default .Summary | plainify | htmlUnescape | strings.TrimSpace }}</description>
      {{- with partial "social-image.html" . }}
      <enclosure url="{{ .Permalink }}" length="{{ len .Content }}" type="image/jpeg" />
      {{- end }}
    </item>
    {{- end }}
  </channel>
</rss>
